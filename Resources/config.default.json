  "modes": [
    {
      "allow_extension": true,
      "apps": [
        {
          "bundle_id": "com.anthropic.claudefordesktop",
          "note": "Claude desktop app. Add team_id after checking it with: intentmode inspect-app /Applications/Claude.app"
        },
        {
          "bundle_id": "com.apple.Terminal",
          "team_id": "apple"
        },
        {
          "bundle_id": "com.google.Chrome",
          "team_id": "EQHXZ8M8AV"
        }
      ],
      "conditional_domains": [
        {
          "domains": [
            "@google_search"
          ],
          "flag": "claude_mode_allow_google_search"
        }
      ],
      "daily_limit": 3,
      "description": "Claude, coding docs, GitHub and package registries",
      "domains": [
        "claude.ai",
        "claude.com",
        "claudeusercontent.com",
        "anthropic.com",
        "challenges.cloudflare.com",
