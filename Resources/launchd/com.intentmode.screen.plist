<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Intent Mode intent screen (runs as the logged-in user). Relaunched whenever it crashes or is killed. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.intentmode.screen</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Library/Application Support/IntentMode/current/IntentScreen.app/Contents/MacOS/IntentScreen</string>
	</array>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<!-- An exempt account exits with 0 and is left alone; any crash or kill relaunches it. -->
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>2</integer>
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
